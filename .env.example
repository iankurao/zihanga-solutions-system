# Zehunger ERP settings. Copy to /etc/zehunger/zehunger.env (chmod 640,
# owner root, group zehunger so only the services can read it) and fill in. Never commit the
# real file. `python -m backend.preflight` checks these before a deployment.

# ---- Required -----------------------------------------------------------------
APP_ENV=production
# 48+ random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Add ?sslmode=require when PostgreSQL is on another machine.
DATABASE_URL=postgresql://zehunger:PASSWORD@localhost:5432/zehunger

# ---- Web address --------------------------------------------------------------
# Printed on QR labels; the address people reach the ERP at.
PUBLIC_BASE_URL=https://erp.example.com
# Proxies in front of the app (nginx = 1). 0 only if clients connect directly.
TRUSTED_PROXY_COUNT=1

# ---- Money ----------------------------------------------------------------------
# Currency of order prices and revenue (ISO code shown next to amounts).
CURRENCY=KES

# ---- Capacity -------------------------------------------------------------------
# gunicorn workers and threads per worker (deploy/gunicorn.conf.py).
WEB_CONCURRENCY=2
GUNICORN_THREADS=4
# Database connections each process may hold.
DB_POOL_MAX=10

# ---- Email for alert notifications (optional) ---------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=
ADMIN_EMAIL=

# ---- Backups (deploy/backup.sh) ---------------------------------------------------
BACKUP_KEEP_DAYS=14

# ---- Leave unset in production ------------------------------------------------------
# CORS_ORIGINS=            # https:// origins of other sites allowed to call the API
# SESSION_COOKIE_SECURE=   # cookies are HTTPS-only by default; 0 is refused in production
# DEMO_GUEST_ACCESS=       # demo servers only (python -m backend.demo)
